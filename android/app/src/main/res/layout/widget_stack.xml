<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_light" android:contentDescription="@null" />
<LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="4dp">
<LinearLayout android:id="@+id/cell_status" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
  <ImageView android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot" android:contentDescription="@null" />
  <TextView android:id="@+id/val_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Online" android:textSize="11sp" android:textColor="#2A3320" android:maxLines="1" android:gravity="center" android:layout_marginStart="4dp" android:layout_marginLeft="4dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/cell_temp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
  <ImageView android:id="@+id/ic_temp" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_temp" android:contentDescription="@null" />
  <TextView android:id="@+id/val_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="14sp" android:textColor="#2A3320" android:maxLines="1" android:gravity="center" android:layout_marginStart="3dp" android:layout_marginLeft="3dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/cell_hum" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
  <ImageView android:id="@+id/ic_hum" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_hum" android:contentDescription="@null" />
  <TextView android:id="@+id/val_hum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="14sp" android:textColor="#2A3320" android:maxLines="1" android:gravity="center" android:layout_marginStart="3dp" android:layout_marginLeft="3dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/cell_soil" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
  <ImageView android:id="@+id/ic_soil" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_soil" android:contentDescription="@null" />
  <TextView android:id="@+id/val_soil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="14sp" android:textColor="#2A3320" android:maxLines="1" android:gravity="center" android:layout_marginStart="3dp" android:layout_marginLeft="3dp"/>
</LinearLayout>
</LinearLayout>
</FrameLayout>
